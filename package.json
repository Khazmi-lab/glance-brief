{
  "name": "glance-brief",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist -o glance-brief.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "server": "node server/src/main.ts",
    "whitelist": "node scripts/set-whitelist.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
